    \
    if duplicates:\
        return \{\
            "action": "duplicate_detected",\
            "existing_items": duplicates,\
            "new_extraction": extraction,\
            "message": f"\uc0\u36825 \u20010 \u29289 \u21697 \u23478 \u37324 \u24050 \u32463 \u26377 \u20102 \u65306 \{duplicates[0]['name']\}"\
