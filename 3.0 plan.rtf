// backend/internal/api/search.go\
func (h *SearchHandler) Search(c echo.Context) error \{\
    userID := getUserID(c)\
    query := c.QueryParam("q")\
    limit, _ := strconv.Atoi(c.QueryParam("limit"))\
    if limit == 0 \{ limit = 20 \}\
    \
    var wg sync.WaitGroup\
    var semantic, text, tag []SearchResult\
    \
    wg.Add(3)\
    go func() \{ defer wg.Done(); semantic = h.semanticSearch(userID, query, limit/2) \}()\
    go func() \{ defer wg.Done(); text = h.textSearch(userID, query, limit/2) \}()\
    go func() \{ defer wg.Done(); tag = h.tagSearch(userID, query, limit/2) \}()\
    wg.Wait()\
    \
    merged := mergeAndDeduplicate(semantic, text, tag)\
    return c.JSON(200, merged)\
\}\
