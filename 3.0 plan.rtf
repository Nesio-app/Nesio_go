// Tesla Fleet API\
func (c *TeslaConnector) Sync(ctx context.Context, cfg *ConnectorConfig) ([]Signal, error) \{\
    client := tesla.NewClient(cfg.Credentials["access_token"])\
    vehicles, _ := client.Vehicles()\
    var signals []Signal\
    \
    for _, v := range vehicles \{\
        data, _ := client.VehicleData(v.ID)\
        \
        if data.ChargeState.BatteryLevel < 20 \{\
            signals = append(signals, Signal\{\
                Type: "alert",\
                Source: "tesla",\
                Title: fmt.Sprintf("Tesla \uc0\u30005 \u37327 \u19981 \u36275  (%d%%)", data.ChargeState.BatteryLevel),\
                Payload: map[string]interface\{\}\{\
                    "battery_level": data.ChargeState.BatteryLevel,\
                    "estimated_range": data.ChargeState.EstimatedRange,\
                \},\
                Severity: 2,\
            \})\
        \}\
        \
        if data.DriveState.ShiftState == "D" \{\
            signals = append(signals, Signal\{\
                Type: "event",\
                Source: "tesla",\
                Title: "\uc0\u39550 \u39542 \u20013 ",\
                Payload: map[string]interface\{\}\{\
                    "lat": data.DriveState.Latitude,\
                    "lng": data.DriveState.Longitude,\
                    "speed": data.DriveState.Speed,\
                \},\
            \})\
        \}\
    \}\
    return signals, nil\
\}\
