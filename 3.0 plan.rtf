// ios/App/App/VisionPlugin.swift\
@objc(VisionPlugin)\
public class VisionPlugin: CAPPlugin \{\
    \
    @objc func recognizeMedicine(_ call: CAPPluginCall) \{\
        guard let imageBase64 = call.getString("image") else \{\
            call.reject("No image provided")\
            return\
        \}\
        \
        guard let imageData = Data(base64Encoded: imageBase64),\
              let image = UIImage(data: imageData) else \{\
            call.reject("Invalid image")\
            return\
        \}\
        \
        let request = VNRecognizeTextRequest \{ request, error in\
            guard let observations = request.results as? [VNRecognizedTextObservation] else \{\
                call.reject("Recognition failed")\
                return\
            \}\
            \
            let text = observations.compactMap \{ $0.topCandidates(1).first?.string \}.joined(separator: "\\n")\
            let medicine = self.parseMedicine(text)\
            \
            call.resolve([\
                "rawText": text,\
                "medicine": [\
                    "name": medicine.name,\
                    "dosage": medicine.dosage,\
                    "frequency": medicine.frequency,\
                    "manufacturer": medicine.manufacturer\
                ]\
            ])\
        \}\
        \
        request.recognitionLevel = .accurate\
        request.recognitionLanguages = ["zh-Hans", "en"]\
        \
        let handler = VNImageRequestHandler(cgImage: image.cgImage!, options: [:])\
        try? handler.perform([request])\
    \}\
    \
    func parseMedicine(_ text: String) -> MedicineInfo \{\
        var info = MedicineInfo()\
        if let match = text.firstMatch(of: /\uc0\u12304 ?(\\S+?)(?:\u33014 \u22218 |\u29255 |\u39063 \u31890 |\u21475 \u26381 \u28082 |\u27880 \u23556 \u28082 )?\u12305 ?/) \{\
            info.name = String(match.1)\
        \}\
        if let match = text.firstMatch(of: /(\\d+(?:\\.\\d+)?)\\s*(mg|g|ml|\uc0\u31890 |\u29255 )/) \{\
            info.dosage = String(match.0)\
        \}\
        if let match = text.firstMatch(of: /(\uc0\u27599 \u26085 \\d+\u27425 |\u26089 \u26202 \u21508 \\d+\u27425 |\u27599 \\d+\u23567 \u26102 \\d+\u27425 )/) \{\
            info.frequency = String(match.0)\
        \}\
        return info\
    \}\
\}\
