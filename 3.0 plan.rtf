@router.post("/ask")\
async def ask_question(req: AskRequest):\
    # 1. \uc0\u24847 \u22270 \u35782 \u21035 \
    intent = await classify_intent(req.question)\
    \
    if intent == "retrieval":\
        # 2. \uc0\u29983 \u25104 \u26597 \u35810 \u21521 \u37327 \
        query_embedding = await embed(req.question)\
        \
        # 3. \uc0\u22810 \u36335 \u21484 \u22238 \
