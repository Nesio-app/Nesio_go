    \
    else:\
        # \uc0\u32842 \u22825 \u22411 \u38382 \u39064 \
        return await chat(req.user_id, req.question)\
\
async def multi_recall(user_id, query, embedding, time_window):\
    results = []\
    \
    # \uc0\u36335 1: Qdrant \u35821 \u20041 \u25628 \u32034 \u65288 name + tags + body\u65289 \
    semantic = await qdrant.search(\
        collection="life_nodes",\
        vector=embedding,\
        filter=\{"must": [\{"key": "user_id", "match": \{"value": user_id\}\}]\},\
        limit=10\
    )\
    results.extend(semantic)\
    \
    # \uc0\u36335 2: Postgres \u32467 \u26500 \u21270 \u23646 \u24615 \u25628 \u32034 \
    attrs = extract_attribute_hints(query)\
    if attrs:\
        sql = """\
            SELECT * FROM life_nodes \
            WHERE user_id = $1 \
              AND attributes @> $2::jsonb\
            LIMIT 10\
        """\
        structured = await pg.fetchall(sql, user_id, json.dumps(attrs))\
        results.extend(structured)\
    \
    # \uc0\u36335 3: \u26102 \u38388 \u33539 \u22260 \u36807 \u28388 \
    if time_window:\
        sql = """\
            SELECT * FROM life_nodes \
            WHERE user_id = $1 \
              AND created_at > $2\
            ORDER BY created_at DESC\
            LIMIT 10\
        """\
        temporal = await pg.fetchall(sql, user_id, time_window)\
        results.extend(temporal)\
    \
    return rerank(results, query)\
