            user_id=req.user_id,\
            query=req.question,\
            embedding=query_embedding,\
            time_window=req.time_hint\
        )\
        \
        # 4. \uc0\u22914 \u26524 \u21484 \u22238 \u32467 \u26524 \u26126 \u30830 \u65292 \u30452 \u25509 \u22238 \u31572 \
        if nodes and len(nodes) <= 3:\
            answer = await generate_direct_answer(req.question, nodes)\
            return \{ "type": "direct", "answer": answer, "sources": nodes \}\
        \
        # 5. \uc0\u22914 \u26524 \u27169 \u31946 \u65292 \u36208  LLM \u32508 \u21512 \
        context = await build_context(req.user_id, nodes)\
        answer = await chat_with_context(req.question, context)\
