\
async def find_visual_duplicates(user_id: str, phash: str, embedding: list):\
    # \uc0\u31574 \u30053 1: pHash \u27721 \u26126 \u36317 \u31163  < 10\
    similar = await pg.fetchall("""\
        SELECT node_id, name, visual_hash \
        FROM item_visual_fingerprints \
        WHERE user_id = $1 \
          AND hamming_distance(visual_hash, $2) < 10\
    """, user_id, phash)\
    \
    if similar:\
        return similar\
    \
    # \uc0\u31574 \u30053 2: CLIP \u21521 \u37327 \u30456 \u20284 \u24230 \
    vector_results = await qdrant.search(\
        collection="item_visual",\
        vector=embedding,\
        filter=\{"must": [\{"key": "user_id", "match": \{"value": user_id\}\}]\},\
        limit=3,\
        score_threshold=0.85\
    )\
    \
    return [\{"node_id": r.id, "name": r.payload["name"]\} for r in vector_results]\
