async function uploadAndExtract(files: File[], note: string) \{\
  const form = new FormData();\
  files.forEach(f => form.append('files', f));\
  form.append('note', note);\
  \
  const res = await fetch('/api/v1/extraction/upload', \{\
    method: 'POST',\
    body: form\
  \});\
  \
  const result = await res.json();\
  \
  for (const extracted of result.extracted) \{\
    await createNode(\{\
      type: extracted.type,\
      name: extracted.name,\
      attributes: extracted.attributes,\
      tags: extracted.tags,\
      raw_input: note,\
      image_url: extracted.image_url\
    \});\
  \}\
  \
  toast.success(`\uc0\u24050 \u35782 \u21035 \u24182 \u23384 \u20648  $\{result.extracted.length\} \u20010 \u26465 \u30446 `);\
\}\
