# ── Backend API & Worker ───────────────────────────────────────────────────────
# Railway provides ${{Postgres.DATABASE_URL}} automatically when you add the plugin
DATABASE_URL=postgresql://USER:PASS@HOST:5432/railway?sslmode=require

# Railway provides ${{Redis.REDIS_URL}} automatically when you add the plugin
REDIS_URL=redis://default:PASS@HOST:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_in_production

# Must be exactly 32 ASCII characters — encrypts connector OAuth tokens
CONNECTOR_SECRET=change_me_to_32_char_secret_here!

# Railway internal hostname of the ai-service (Railway fills this automatically)
AI_SERVICE_URL=https://ai-service.railway.internal

# Qdrant — add the Qdrant Railway template, then use its internal URL
QDRANT_URL=http://qdrant.railway.internal:6333

# ── Google OAuth (for Gmail connect) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Set this to your Railway API domain, e.g.:
GOOGLE_REDIRECT_URI=https://api-nesio.up.railway.app/api/v1/connectors/gmail/oauth/callback

# ── AI Service ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
KIMI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
