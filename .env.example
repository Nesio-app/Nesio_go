# ── Backend API & Worker ───────────────────────────────────────────────────────
# Railway provides ${{Postgres.DATABASE_URL}} automatically when you add the plugin
DATABASE_URL=postgresql://USER:PASS@HOST:5432/railway?sslmode=require

# Railway provides ${{Redis.REDIS_URL}} automatically when you add the plugin
REDIS_URL=redis://default:PASS@HOST:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_in_production

# Must be exactly 32 ASCII characters — encrypts connector OAuth tokens
CONNECTOR_SECRET=change_me_to_32_char_secret_here!

# Railway internal hostname of the ai-service (Railway fills this automatically)
AI_SERVICE_URL=https://ai-service.railway.internal

# Qdrant — add the Qdrant Railway template, then use its internal URL
QDRANT_URL=http://qdrant.railway.internal:6333

# ── Google OAuth (for Gmail connect) ──────────────────────────────────────────
# Leave blank until you have a real Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this to your Railway API domain, e.g.:
GOOGLE_REDIRECT_URI=https://api-nesio.up.railway.app/api/v1/connectors/gmail/oauth/callback

# ── Connector OAuth (Tesla/Granola/Plaid/Flomo/Timeline/Health) ─────────────
# Public API origin for connector callback URLs, e.g. https://api-nesio.up.railway.app
CONNECTOR_OAUTH_REDIRECT_BASE_URL=
# Frontend URL to return to after connector OAuth callback, e.g. https://nesio-app.github.io/Nesio_go/
CONNECTOR_OAUTH_CLIENT_REDIRECT_URL=
# Each value should be the provider's OAuth authorize URL (without state).
# The server appends `state` and `redirect_uri` automatically.
CONNECTOR_TESLA_FLEET_AUTH_URL=
CONNECTOR_GRANOLA_AUTH_URL=
CONNECTOR_PLAID_AUTH_URL=
CONNECTOR_GOOGLE_TIMELINE_AUTH_URL=
CONNECTOR_FLOMO_AUTH_URL=
CONNECTOR_APPLE_HEALTH_AUTH_URL=

# Optional: OAuth token exchange (authorization code -> access_token).
# When all three vars for a provider are set, callback will auto-exchange code and activate connector.
CONNECTOR_TESLA_FLEET_TOKEN_URL=
CONNECTOR_TESLA_FLEET_CLIENT_ID=
CONNECTOR_TESLA_FLEET_CLIENT_SECRET=

CONNECTOR_GRANOLA_TOKEN_URL=
CONNECTOR_GRANOLA_CLIENT_ID=
CONNECTOR_GRANOLA_CLIENT_SECRET=

CONNECTOR_PLAID_TOKEN_URL=
CONNECTOR_PLAID_CLIENT_ID=
CONNECTOR_PLAID_CLIENT_SECRET=

CONNECTOR_GOOGLE_TIMELINE_TOKEN_URL=
CONNECTOR_GOOGLE_TIMELINE_CLIENT_ID=
CONNECTOR_GOOGLE_TIMELINE_CLIENT_SECRET=

CONNECTOR_FLOMO_TOKEN_URL=
CONNECTOR_FLOMO_CLIENT_ID=
CONNECTOR_FLOMO_CLIENT_SECRET=

CONNECTOR_APPLE_HEALTH_TOKEN_URL=
CONNECTOR_APPLE_HEALTH_CLIENT_ID=
CONNECTOR_APPLE_HEALTH_CLIENT_SECRET=

# ── AI Service ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
KIMI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
